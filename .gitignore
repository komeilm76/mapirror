# Dependencies
node_modules/
.bun/

# Build output
dist/
build/
coverage/
*.tsbuildinfo

# Environment and secrets
# Keep the pattern set in sync with `.dockerignore` — `bun run check:hygiene` asserts both files cover
# the same credential shapes, because a key ignored by one and not the other is a key in git.
.env
.env.*
!.env.example
*.pem
*.key
*.p12
secrets/

# Runtime data (map artifacts, database, uploads) — volumes in production
data/
backups/

# Logs and OS noise
*.log
.DS_Store
