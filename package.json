{
  "name": "mapirror",
  "version": "0.2.0-dev",
  "private": true,
  "type": "module",
  "description": "Self-hosted cache and download mirror for OpenStreetMap country extracts (Geofabrik).",
  "license": "MIT",
  "packageManager": "bun@1.4.4",
  "engines": {
    "bun": ">=1.2.0"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "check": "bun run check:workspaces && bun run check:hygiene && bun run typecheck && bun run lint && bun run format:check && bun run test",
    "check:hygiene": "bun run scripts/check-hygiene.ts",
    "check:full": "bun run check && bun run test:coverage",
    "check:workspaces": "bun run scripts/check-workspaces.ts",
    "typecheck": "tsc -p tsconfig.json && bun run --filter './packages/*' typecheck && bun run --filter './apps/*' typecheck",
    "lint": "eslint . --max-warnings=0",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "start:api": "bun run --filter @mapirror/api start",
    "dev:api": "bun run --filter @mapirror/api dev",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:api": "vitest run --project api",
    "test:web": "vitest run --project web",
    "test:shared": "vitest run --project shared",
    "test:scripts": "vitest run --project scripts"
  },
  "devDependencies": {
    "@eslint/js": "9.39.5",
    "@types/bun": "1.4.4",
    "@vitest/coverage-v8": "5.0.5",
    "eslint": "9.39.5",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-vue": "10.11.1",
    "globals": "17.13.0",
    "jsdom": "30.1.3",
    "prettier": "3.9.10",
    "typescript": "5.9.3",
    "typescript-eslint": "8.72.0",
    "vite": "8.3.5",
    "vitest": "5.0.5",
    "vue-eslint-parser": "10.4.1"
  }
}
