{
  "$schema": "https://json.schemastore.org/tsconfig",
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    /* The SPA runs in a browser: add DOM libs and drop the Bun type surface. */
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "types": [],
    /* `vite.config.ts` imports its two helpers **with** the extension — Vite 8 warns that the extensionless form does
       not survive its planned `native` config loader, and a config that stops loading is a dev server that does not
       start (`dev-proxy.ts` records the failure that made this the rule). */
    "allowImportingTsExtensions": true,
    /* `@/…` and `vite.config.ts`'s alias must be the same string, or the editor resolves an import the build cannot. */
    "paths": {
      "@/*": ["./src/*"]
    }
  },
  /* `.vue` files ARE listed here since `P1-WEB-01`: that task replaced the web `typecheck` script with `vue-tsc`,
     which is the compiler that can read an SFC. Plain `tsc` silently ignores them, and a typecheck that reports
     success on a broken component is worse than no typecheck — the note this replaces said exactly that. */
  "include": ["src/**/*.ts", "src/**/*.vue", "tests/**/*.ts", "vite.config.ts"],
  "exclude": ["node_modules", "dist"]
}
