# MapMirror — environment template
#
# Copy to `.env` and fill in the secrets:  cp .env.example .env && chmod 600 .env
# `.env` is gitignored; this file is the canonical list and is kept in sync with
# `docs/09-development.md` §5 by `bun run check:hygiene` — add a variable in both places.
#
# Never commit real credentials. In production prefer the `*_FILE` variants below
# (mounted as Docker secrets) over plain values.
#
# These defaults are for **native development** (`bun run dev`): relative paths, `localhost` DSN.
# `compose.yaml` runs the same code against container paths and its own host name: it replaces the
# DSN below with one that carries **no password** (`postgres://mapirror@db:5432/mapirror`) and the
# API completes it from `POSTGRES_PASSWORD`. So the password exists in exactly one variable, and a
# password containing `@`, `:`, `/`, `?`, `#` or `%` — which cannot survive a URL — is fine there.
# `cp .env.example .env` is therefore correct for both flows.

# ─────────────────────────────────────────────────────────────── runtime ──
# development | production | test
NODE_ENV=development
PORT=3000
HOST=0.0.0.0

# ────────────────────────────────────────────────────────────── database ──
# Password for the bundled PostgreSQL container, and the single source of the API's DSN inside
# compose: `postgres://mapirror:<POSTGRES_PASSWORD>@db:5432/mapirror`. Never hand-write that DSN —
# two copies of one password drift apart, and the failure looks like an authentication bug.
# CHANGE THIS before exposing the host.
POSTGRES_PASSWORD=mapirror
# POSTGRES_PASSWORD_FILE=/run/secrets/postgres_password

# Direct DSN, used when the API runs outside Docker (native `bun run dev`, tests, CI) — with its password in it, which
# is the one place this project writes a password into a URL: it is your own development database.
# `compose.yaml` replaces this value with one that carries no password at all (`postgres://mapirror@db:5432/mapirror`)
# and the API completes it from POSTGRES_PASSWORD, so a password containing `@`, `/`, `#`, `?` or `%` works there too.
DATABASE_URL=postgres://mapirror:mapirror@localhost:5432/mapirror
# Used only by integration tests; they create and truncate this database.
DATABASE_URL_TEST=postgres://mapirror:mapirror@localhost:5432/mapirror_test
DB_POOL_MAX=10
# Apply pending SQL migrations before the API serves. `true` for `bun run dev`; a container entrypoint that
# migrates first (`P1-DOCK-04`) can set `false` to make boot read-only. The *version check* always runs: a
# schema that is behind or ahead of the code stops the boot either way.
MIGRATE_ON_BOOT=true

# ──────────────────────────────────────────────────────────────── storage ──
# Artifact storage. Relative here so native dev writes inside the repository (`data/` is gitignored)
# instead of needing write access to `/`; compose overrides both with its mounted volumes
# (`/data/cache`, `/data/tmp`).
CACHE_DIR=./data/cache
# Upload staging and `.part` files.
TMP_DIR=./data/tmp

# ─────────────────────────────────────────────────────────────────── http ──
# Comma-separated allow-list for cross-origin requests. Empty = same-origin only.
# Never set `*`: admin endpoints are authenticated.
CORS_ORIGINS=
# Public URL of the deployment; used to build download links shown in the UI/API.
PUBLIC_BASE_URL=http://localhost:8080

# ────────────────────────────────────────────────────────────── branding ──
BRANDING_DISPLAY_NAME=MapMirror
# Defaults to the version in package.json when unset.
APP_VERSION=

# ───────────────────────────────────────────────────────────── admin auth ──
# Used only at first boot to create the admin (idempotent). Not re-read afterwards.
ADMIN_USERNAME=admin
# REQUIRED for a fresh install. Minimum 12 characters. Never commit a real value.
ADMIN_PASSWORD=
# ADMIN_PASSWORD_FILE=/run/secrets/admin_password

# Bearer token lifetime; tokens are opaque and stored hashed.
AUTH_TOKEN_TTL_HOURS=12
# Failed logins before the IP+username pair is throttled, and for how long.
AUTH_MAX_LOGIN_ATTEMPTS=10
AUTH_LOCKOUT_MINUTES=15
# Salt for hashed download IPs. Leave empty: generated on first boot and stored in the database.
IP_HASH_SALT=
# Which peers may assert a client address in `X-Forwarded-For`. Everything per-IP depends on this: rate limits
# and hashed download IPs. The default is right for the documented same-host reverse proxy; a proxy on another
# host or in a container needs its address or subnet (e.g. `172.16.0.0/12`), and `none` disables trust.
# A hop count (`1`) is refused: Fastify silently trusts nothing for a number, so the proxy would look configured
# and do nothing. `true` is refused too — it trusts every peer, letting any client choose its own address.
TRUST_PROXY=loopback

# ───────────────────────────────────────────────────────────────── worker ──
WORKER_ENABLED=true
WORKER_CONCURRENCY=2
# Finished jobs are pruned after this many days.
JOB_RETENTION_DAYS=30

# ────────────────────────────────────────────────────────────── transfers ──
# Import size cap (8 GiB) and the free-space floor kept on CACHE_DIR (2 GiB).
MAX_UPLOAD_BYTES=8589934592
DISK_RESERVE_BYTES=2147483648
# Per-IP limit for public downloads, counted at request start.
PUBLIC_DOWNLOADS_PER_MINUTE=10

# ───────────────────────────────────────────────────────────────── source ──
GEOFABRIK_BASE_URL=https://download.geofabrik.de
# How long the catalog is considered fresh before a sync is suggested.
CATALOG_TTL_MINUTES=360

# ──────────────────────────────────────────────────────────────── metrics ──
METRICS_INTERVAL_SECONDS=10
METRICS_RETENTION_DAYS=7

# ──────────────────────────────────────────────────────────────── logging ──
# fatal | error | warn | info | debug | trace
LOG_LEVEL=info
